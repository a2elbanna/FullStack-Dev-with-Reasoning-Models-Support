# Merge needed entries into your .env; keep existing credentials private.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_API_MODE=auto
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=32768

# Astra planning only: initial budget and ceiling for one output-limit retry.
OPENAI_PLANNING_MAX_OUTPUT_TOKENS=65536
OPENAI_PLANNING_RETRY_MAX_OUTPUT_TOKENS=128000

# The browser tester can use its own model and credentials.
VLM_MODEL=gpt-6-astra
VLM_API_MODE=auto
# Optional: otherwise falls back to existing OPENAILIKE_VLM_* or OPENAI_*.
# OPENAI_VLM_API_KEY=your-api-key
# OPENAI_VLM_BASE_URL=https://api.openai.com/v1
